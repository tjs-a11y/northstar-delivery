{
  "name": "nsnn-pipeline",
  "version": "1.0.0",
  "private": true,
  "description": "NSNN (NorthStar News Network) daily freight brief: public data harvest, Claude-written brief with fact check, signal-based CTAs, static news pages, Beehiiv newsletter.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test scripts/marketing/test/*.test.mjs",
    "nsnn:sources": "node scripts/marketing/pipeline.mjs --sources-only",
    "nsnn": "node scripts/marketing/pipeline.mjs",
    "nsnn:publish": "node scripts/marketing/pipeline.mjs --publish",
    "nsnn:draft": "node scripts/marketing/pipeline.mjs --publish --beehiiv=draft"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "rss-parser": "^3.13.0"
  }
}
